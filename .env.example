# Used to sign secretariat session cookies. Set a long random value in production.
AUTH_SECRET=

# Resend settings for passwordless login emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Development/bootstrap only. When true, entering "admin" prints a magic link to the server terminal.
# Never set this in production.
AUTH_BYPASS=false
AUTH_BYPASS_ADMIN_EMAIL=test@test.test
