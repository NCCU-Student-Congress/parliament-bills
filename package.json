{
  "name": "nuxt-app",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "typecheck": "nuxi typecheck",
    "dev": "TMPDIR=/tmp wrangler d1 migrations apply DB --local --persist-to .wrangler/state && TMPDIR=/tmp nuxt dev",
    "dev-mac": "pnpm run dev",
    "generate": "nuxt generate",
    "preview": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state && pnpm run build && wrangler dev --persist-to .wrangler/state",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "nuxt": "^4.4.7",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "nuxi": "^3.25.1",
    "prettier": "^3.9.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "wrangler": "^4.68.1"
  },
  "packageManager": "pnpm@11.9.0"
}
